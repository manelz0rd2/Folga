{
  "name": "folga",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:macos": "vite --mode macos",
    "dev:windows": "vite --mode windows",
    "build": "tsc && vite build",
    "build:windows-ui": "tsc && vite build --mode windows",
    "build:macos-ui": "tsc && vite build --mode macos",
    "test": "pnpm test:ui && pnpm test:native",
    "test:ui": "tsc --noEmit && vite build --mode windows",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:windows": "tauri build --config src-tauri/tauri.windows.conf.json --bundles msi",
    "tauri:macos": "tauri build --config src-tauri/tauri.macos.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  },
  "packageManager": "pnpm@10.18.1"
}
